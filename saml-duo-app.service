[Unit]
Description=SAML Duo demo app (Flask)
After=network.target

[Service]
Type=simple
User=cisco
WorkingDirectory=/home/cisco/saml-app-duo
Environment=PATH=/home/cisco/saml-app-duo/venv/bin
ExecStart=/home/cisco/saml-app-duo/venv/bin/python3 /home/cisco/saml-app-duo/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
