# Flask
FLASK_SECRET_KEY=change-me-to-a-random-value
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
# Set to "on" once you are running behind HTTPS (required in production, and
# Duo will only redirect back to an https:// ACS URL for anything but localhost testing)
SP_HTTPS=off

# --- Service Provider (this app) ---
# A unique identifier for this app. Convention: the metadata URL.
SP_ENTITY_ID=http://localhost:5000/saml/metadata
# Must exactly match the "Assertion Consumer Service (ACS) URL" you configure in Duo.
SP_ACS_URL=http://localhost:5000/saml/acs
# Must exactly match the "Single Logout URL" you configure in Duo (optional feature).
SP_SLS_URL=http://localhost:5000/saml/sls
# Leave these blank to skip signing AuthnRequests/LogoutRequests. Fill them in
# (paths to files under certs/) if you want the SP to sign requests.
SP_CERT_FILE=
SP_KEY_FILE=

# --- Identity Provider (Duo) ---
# From Duo Admin Panel > Applications > your Generic Service Provider app > Metadata section.
IDP_ENTITY_ID=
IDP_SSO_URL=
IDP_SLS_URL=
# Paste Duo's certificate contents (base64, no PEM header/footer, single line) here,
# or point IDP_CERT_FILE at a downloaded .pem/.crt file instead.
IDP_X509_CERT=
IDP_CERT_FILE=
