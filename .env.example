# Flask
FLASK_SECRET_KEY=change-me-to-a-random-value
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
# Set to "on" once you are running behind HTTPS (required in production, and
# Duo will only redirect back to an https:// ACS URL for anything but localhost testing)
SP_HTTPS=off

# Password for the /admin UI, where you manage the Duo SAML connection
# (entity IDs, SSO/SLO URLs, IdP certificate) without editing files. Required
# to unlock /admin; leave blank to keep it locked.
ADMIN_PASSWORD=change-me

# Optional: paths to a cert/key pair (see generate_sp_cert.sh) if you want the
# SP to sign AuthnRequests/LogoutRequests. Leave blank to skip SP-side signing.
SP_CERT_FILE=
SP_KEY_FILE=

# --- Optional one-time seed values ---
# Everything below is only used the first time the app runs, to pre-fill the
# /admin settings form. After that, edit these values from /admin instead —
# they're stored in instance/saml_settings.json, not read from .env again.
SP_ENTITY_ID=http://localhost:5000/saml/metadata
SP_ACS_URL=http://localhost:5000/saml/acs
SP_SLS_URL=http://localhost:5000/saml/sls
IDP_ENTITY_ID=
IDP_SSO_URL=
IDP_SLS_URL=
IDP_X509_CERT=
